# ===== PAS backend · ตัวอย่าง env (คัดลอกเป็น .env แล้วใส่ค่าจริง · อย่า commit .env) =====

# ---- ฐานข้อมูล ----
# local (docker-compose): postgres service ชื่อ db
DATABASE_URL=postgres://pas:pas@db:5432/pas
# Azure Database for PostgreSQL (บังคับ SSL — ใส่ ?sslmode=require):
# DATABASE_URL=postgres://<user>:<pass>@<server>.postgres.database.azure.com:5432/pas?sslmode=require
# PGSSLROOTCERT=/certs/DigiCertGlobalRootCA.crt.pem   # (ทางเลือก) ระบุ CA เอง
# PGSSL_INSECURE=1                                    # ปิด verify — เฉพาะ dev เท่านั้น

PORT=3000
PG_POOL_MAX=8

# ---- Login: Microsoft Entra ID (OIDC มาตรฐาน) ----
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=<application-client-id>
OIDC_CLIENT_SECRET=<client-secret>
OIDC_REDIRECT_URI=https://<โฮสต์ของคุณ>/auth/callback
OIDC_SCOPE=openid email profile
SESSION_SECRET=<สุ่มยาว ≥32 ตัว · เช่น `openssl rand -base64 48`>
AUTH_REQUIRED=1        # 1 = บังคับ login · เว้นว่าง = เปิดดูได้ (dev)
COOKIE_SECURE=1        # 1 = คุกกี้ Secure (เมื่อรันหลัง HTTPS/Azure)

# ---- อีเมลแจ้งเตือน: Microsoft 365 (SMTP) ----
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=notify@yourdomain.com
SMTP_PASS=<app password / secret>
SMTP_FROM=PAS แจ้งเตือน <notify@yourdomain.com>
