var CMAP={},ALL=[];
RAW.weekly_teams.concat(RAW.monthly_teams).forEach(function(t){if(ALL.indexOf(t.team)<0)ALL.push(t.team);});
ALL.forEach(function(t,i){CMAP[t]=COLORS[i%COLORS.length];});
var S={wK:'count',wD:-1,mK:'count',mD:-1,wT:'',mT:'',wQ:'',mQ:''};
function card(c,l,v,s){return '<div class="stat-card" style="--accent-color:'+c+'"><div class="stat-label">'+l+'</div><div class="stat-val">'+v+'</div><div class="stat-sub">'+esc(s)+'</div></div>';}
function statRow(emps,teams,repLabel){var t1=0,t2=0,i;for(i=0;i<emps.length;i++){t1+=emps[i].count;t2+=emps[i].total_hours;}var rep=emps.filter(function(e){return e.count>=2;}).length;var top=emps[0]||{count:0,name:''};return '<div class="stat-row">'+card('#f97316','ครั้ง OT รวม',t1,'ทั้งหมด '+emps.length+' คน')+card('#3b82f6','ชั่วโมงรวมทั้งหมด',fmt(t2),'ชั่วโมง OT รวม')+card('#ef4444',repLabel,rep,'พนักงาน')+card('#a855f7','จำนวนทีม',teams.length,'ทีมที่มี OT')+card('#16a34a','สูงสุด (คน)',top.count,String(top.name).split(' ')[0])+'</div>';}
function bars(teams){var mx=Math.max.apply(null,teams.map(function(t){return t.count;}));return teams.map(function(t){var pct=(t.count/mx*100).toFixed(1);var col=CMAP[t.team]||'#3b82f6';return '<div class="bar-row"><div class="bar-label" title="'+esc(t.team)+'">'+esc(t.team)+'</div><div class="bar-track"><div class="bar-fill" style="width:'+pct+'%;--fill-color:'+col+'">'+t.count+' ครั้ง · '+t.unique_employees+' คน</div></div><div class="bar-extra">'+fmt(t.total_hours)+' ชม.</div></div>';}).join('');}
function rowsHtml(emps,type){if(!emps.length)return '<tr><td colspan="7" class="empty-state">ไม่พบข้อมูล</td></tr>';return emps.map(function(e){var col=CMAP[e.team]||'#64748b';var bc=bcls(type==='m'?e.count*2:e.count);var rid=type+'r_'+e.code,eid=type+'e_'+e.code,cid='chv_'+type+'_'+e.code,ec='exp_'+type+'_'+e.code;return '<tr id="'+rid+'" onclick="otToggleExpand(\\''+type+'\\',\\''+e.code+'\\')"><td><strong>'+esc(e.name)+'</strong><br><span class="ot-code">'+e.code+'</span></td><td><span class="team-tag" style="background:'+col+'22;color:'+col+'">'+esc(e.team)+'</span></td><td><span class="badge-repeat '+bc+'">'+e.count+'</span></td><td><span class="badge-hours">'+fmtH(e.total_hours)+'</span></td><td class="mono">'+fmt(e.max_hours)+'</td><td class="mono">'+fmt(e.avg_hours)+'</td><td><span class="chevron" id="'+cid+'">›</span></td></tr><tr class="expand-row" id="'+eid+'"><td colspan="7"><div class="expand-inner" id="'+ec+'"></div></td></tr>';}).join('');}
function filterSort(emps,q,team,key,dir){var data=emps.slice();if(team)data=data.filter(function(e){return e.team===team;});if(q){var ql=q.toLowerCase();data=data.filter(function(e){return e.name.indexOf(q)>=0||String(e.code).indexOf(q)>=0||e.team.toLowerCase().indexOf(ql)>=0;});}data.sort(function(a,b){var av=typeof a[key]==='string'?a[key]:Number(a[key]);var bv=typeof b[key]==='string'?b[key]:Number(b[key]);return av>bv?dir:av<bv?-dir:0;});return data;}
function teamOpts(emps){var ts=[];emps.forEach(function(e){if(ts.indexOf(e.team)<0)ts.push(e.team);});ts.sort();return '<option value="">— ทุกทีม —</option>'+ts.map(function(t){return '<option value="'+esc(t)+'">'+esc(t)+'</option>';}).join('');}
function thRow(type){var cols=[['name','ชื่อ-สกุล'],['team','ทีม'],['count',type==='w'?'สัปดาห์ที่ OT ซ้ำ':'เดือนที่ OT ซ้ำ'],['total_hours','รวมชั่วโมง'],['max_hours',type==='w'?'Max/สัปดาห์':'Max/เดือน'],['avg_hours','เฉลี่ย']];var K=type==='w'?S.wK:S.mK,D=type==='w'?S.wD:S.mD;return '<tr>'+cols.map(function(c){var on=c[0]===K;return '<th class="'+(on?'sorted':'')+'" onclick="otSort(\\''+type+'\\',\\''+c[0]+'\\')">'+c[1]+' <span class="sort-icon">'+(on?(D>0?'↑':'↓'):'↕')+'</span></th>';}).join('')+'<th></th></tr>';}
function panel(type){var crit=type==='w'?'&gt; 36 ชม./สัปดาห์':'&gt; 145 ชม./เดือน';var span=type==='w'?'ต.ค. 68 – เม.ย. 69':'พ.ย. 68 – เม.ย. 69';var nT=type==='w'?'29 สัปดาห์':'6 เดือน';var src=type==='w'?'ชีต23':'ชีต25';var emps=type==='w'?RAW.weekly_employees:RAW.monthly_employees;var teams=type==='w'?RAW.weekly_teams:RAW.monthly_teams;var repLabel=type==='w'?'ซ้ำ ≥ 2 สัปดาห์':'ซ้ำ ≥ 2 เดือน';return '<div class="info-panel"><div class="info-item">เกณฑ์: <strong>'+crit+'</strong></div><div class="info-item">ช่วงข้อมูล: <strong>'+span+'</strong></div><div class="info-item">จำนวน: <strong>'+nT+'</strong></div><div class="info-item">แหล่งข้อมูล: <strong>'+src+'</strong></div></div>'+statRow(emps,teams,repLabel)+'<div class="section"><div class="section-header"><div class="section-title"><span class="dot"></span> สรุปรายทีม – ครั้ง OT, จำนวนคน, รวมชั่วโมง</div></div><div class="bar-chart" id="ot-'+type+'-bars"></div></div><div class="section"><div class="section-header"><div class="section-title"><span class="dot" style="background:#3b82f6"></span> รายชื่อพนักงาน OT '+(type==='w'?'ซ้ำ':'เกินรายเดือน')+'</div></div><div class="filter-row"><input class="search-box" placeholder="🔍  ค้นหาชื่อ / รหัสพนักงาน…" oninput="otQuery(\\''+type+'\\',this.value)"/><select class="filter-select" id="ot-'+type+'-team" onchange="otTeam(\\''+type+'\\',this.value)"></select><span class="result-count" id="ot-'+type+'-count"></span></div><div class="emp-table-wrap"><table id="ot-'+type+'-table"><thead id="ot-'+type+'-thead"></thead><tbody id="ot-'+type+'-tbody"></tbody></table></div></div>';}
function renderTable(type){var emps=type==='w'?RAW.weekly_employees:RAW.monthly_employees;var q=type==='w'?S.wQ:S.mQ,team=type==='w'?S.wT:S.mT,key=type==='w'?S.wK:S.mK,dir=type==='w'?S.wD:S.mD;var data=filterSort(emps,q,team,key,dir);document.getElementById('ot-'+type+'-thead').innerHTML=thRow(type);document.getElementById('ot-'+type+'-tbody').innerHTML=rowsHtml(data,type);document.getElementById('ot-'+type+'-count').textContent='แสดง '+data.length+' รายการ';}
function build(type){document.getElementById('ot-tab-'+(type==='w'?'weekly':'monthly')).innerHTML=panel(type);document.getElementById('ot-'+type+'-team').innerHTML=teamOpts(type==='w'?RAW.weekly_employees:RAW.monthly_employees);document.getElementById('ot-'+type+'-bars').innerHTML=bars(type==='w'?RAW.weekly_teams:RAW.monthly_teams);renderTable(type);}
window.otSort=function(type,key){if(type==='w'){if(S.wK===key)S.wD*=-1;else{S.wK=key;S.wD=key==='name'?1:-1;}}else{if(S.mK===key)S.mD*=-1;else{S.mK=key;S.mD=key==='name'?1:-1;}}renderTable(type);};
window.otQuery=function(type,v){if(type==='w')S.wQ=v;else S.mQ=v;renderTable(type);};
