window.otToggleExpand=function(type,code){var arr=type==='w'?RAW.weekly_employees:RAW.monthly_employees,emp=null,i;for(i=0;i<arr.length;i++)if(String(arr[i].code)===String(code)){emp=arr[i];break;}var eid=type+'e_'+code,rid=type+'r_'+code,cid='chv_'+type+'_'+code,ec='exp_'+type+'_'+code;var er=document.getElementById(eid),row=document.getElementById(rid),chv=document.getElementById(cid);if(!er)return;if(er.classList.contains('visible')){er.classList.remove('visible');if(row)row.classList.remove('expanded');if(chv)chv.classList.remove('open');return;}er.classList.add('visible');if(row)row.classList.add('expanded');if(chv)chv.classList.add('open');var d=document.getElementById(ec),det=(emp&&emp.details)||[];if(!det.length){d.innerHTML='<span class="detail-label">ไม่มีรายละเอียดเพิ่มเติม</span>';return;}var isW=type==='w',k=isW?'week':'month',lim=isW?36:145;d.innerHTML='<span class="detail-label">'+(isW?'สัปดาห์ที่เกิน':'เดือนที่เกิน')+':</span>'+det.map(function(x){var over=x.hours-lim;return '<div class="detail-chip">'+esc(x[k])+': <span>'+fmt(x.hours)+' ชม.</span> <span class="ot-over">(+'+fmt(over)+')</span></div>';}).join('');};
